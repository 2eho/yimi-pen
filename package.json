{
  "name": "yimi-pen",
  "version": "0.1.0",
  "private": false,
  "description": "益米 Yimi Pen — open-source kids IP talking-pen platform (community content packs, Mi-home friendly hooks; not affiliated with Xiaomi)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:admin": "npm run dev -w @yimi-pen/admin-web",
    "dev:sim": "npm run dev -w @yimi-pen/device-sim",
    "validate:books": "node scripts/validate-books.mjs",
    "validate:architecture": "node scripts/validate-architecture.mjs",
    "validate:hardware-system": "node scripts/validate-hardware-system.mjs",
    "generate:eda-system-skeleton": "node scripts/generate-eda-system-skeleton.mjs --write",
    "check:eda-system-skeleton": "node scripts/generate-eda-system-skeleton.mjs --check",
    "test:eda-system-skeleton": "node scripts/test-eda-system-skeleton.mjs",
    "validate:eda-system-skeleton": "npm run generate:eda-system-skeleton && npm run check:eda-system-skeleton && node scripts/validate-eda-system-skeleton.mjs && npm run test:eda-system-skeleton",
    "validate:golden-24-projection": "node scripts/generate-golden-24-projection.mjs",
    "generate:golden-24-projection": "node scripts/generate-golden-24-projection.mjs --write",
    "validate:product-baseline": "node scripts/validate-product-baseline.mjs",
    "generate:evt0-host-audio": "pwsh -NoProfile -File scripts/generate-evt0-host-audio.ps1",
    "generate:family-alpha-assets": "node tools/family-alpha-compiler/golden-assets.mjs --write",
    "test:snapshot-sim": "node tools/snapshot-sim/run-scenarios.mjs",
    "test:device-link-sim": "node tools/device-link-sim/run-transcript.mjs",
    "test:family-build-adapter": "node tools/family-build-adapter/run-golden.mjs",
    "test:companion-host": "npm test -w @yimi-pen/companion-app",
    "test:companion-capture-authoring": "npm run test:capture-authoring -w @yimi-pen/companion-app",
    "test:companion-authoring-product-shell": "npm run test:authoring-product-shell -w @yimi-pen/companion-app",
    "test:companion-authoring-task-recovery": "npm run test:authoring-task-recovery -w @yimi-pen/companion-app",
    "test:companion-tts-source-adapter": "npm run test:tts-source-adapter -w @yimi-pen/companion-app",
    "test:companion-asset-vault-maintenance": "npm run test:asset-vault-maintenance -w @yimi-pen/companion-app",
    "test:companion-asset-vault-recovery": "npm run test:asset-vault-recovery -w @yimi-pen/companion-app",
    "test:companion-family-workspace": "npm run test:family-workspace -w @yimi-pen/companion-app",
    "test:companion-family-workspace-lifecycle": "npm run test:family-workspace-lifecycle -w @yimi-pen/companion-app",
    "test:companion-desktop-authoring-task": "npm run test:desktop-authoring-task -w @yimi-pen/companion-app",
    "verify:companion-real-prelisten": "npm run build -w @yimi-pen/audio && node apps/companion-app/src/prelisten/run-real-prelisten.mjs",
    "verify:companion-real-authored": "npm run build -w @yimi-pen/audio && node apps/companion-app/src/authoring/run-real-authored-flow.mjs",
    "test:family-repository": "node tools/family-repository/run-conformance.mjs",
    "validate:family-repository-contracts": "npm run test:family-build-adapter && npm run test:family-repository",
    "test:confirmation-trust": "node tools/confirmation-trust/run-validation.mjs",
    "test:confirmation-provider-qualification": "node tools/confirmation-trust/run-provider-qualification.mjs",
    "test:family-alpha-compiler": "node tools/family-alpha-compiler/run-golden.mjs",
    "test:execution-model-core": "node tools/execution-model/run-crosscheck.mjs",
    "test:execution-model": "npm run test:family-alpha-compiler && npm run test:execution-model-core",
    "test:weighted-random-v2": "node tools/weighted-random/run-validation.mjs",
    "generate:release-gate-catalog": "node tools/release-gates/refresh-catalog.mjs --write",
    "validate:release-gate-catalog": "node tools/release-gates/refresh-catalog.mjs",
    "test:release-gate-conformance": "node tools/release-gates/run-conformance.mjs",
    "evaluate:release-gates": "node tools/release-gates/evaluate-current.mjs",
    "validate:release-gates": "npm run validate:release-gate-catalog && npm run test:release-gate-conformance",
    "validate:evt0-intake": "node scripts/validate-evt0-intake.mjs",
    "prepare:benchmark-seller-evidence": "node scripts/prepare-benchmark-seller-evidence.mjs",
    "test:benchmark-seller-evidence-prep": "node scripts/test-benchmark-seller-evidence-prep.mjs",
    "validate:benchmark-seller-evidence": "node scripts/validate-benchmark-seller-evidence.mjs && node scripts/test-benchmark-seller-evidence-prep.mjs",
    "validate:hardware-lab": "node scripts/validate-hardware-lab.mjs && node scripts/test-hardware-lab-registry-prep.mjs",
    "discover:hardware-lab": "pwsh -NoProfile -File scripts/discover-hardware-lab.ps1",
    "prepare:hardware-lab-registry": "npm run discover:hardware-lab && npm run validate:hardware-lab && node scripts/prepare-hardware-lab-registry.mjs",
    "test:hardware-lab-registry-prep": "node scripts/test-hardware-lab-registry-prep.mjs",
    "validate:vendor-evidence": "node scripts/validate-vendor-evidence.mjs",
    "validate:vendor-outbound": "node scripts/build-vendor-outbound.mjs && node scripts/build-vendor-outbound.mjs --check",
    "preflight:hardware-evidence": "node scripts/capture-hardware-evidence.mjs preflight",
    "capture:hardware-evidence": "node scripts/capture-hardware-evidence.mjs capture",
    "check:hardware-evidence": "node scripts/capture-hardware-evidence.mjs check",
  "test:hardware-evidence-capture": "node scripts/test-hardware-evidence-capture.mjs",
  "validate:hardware-evidence-capture": "node scripts/validate-hardware-evidence-capture.mjs",
  "validate:hardware-test-fixture": "node scripts/validate-hardware-test-fixture.mjs",
  "test:hardware-test-fixture": "node scripts/test-hardware-test-fixture.mjs",
  "validate:hardware-method-gap-evidence": "node scripts/validate-hardware-method-gap-evidence.mjs",
  "test:hardware-method-gap-evidence": "node scripts/test-hardware-method-gap-evidence.mjs",
  "validate:hardware-fixture-method-contract": "node scripts/validate-hardware-fixture-method-contract.mjs",
  "test:hardware-fixture-method-contract": "node scripts/test-hardware-fixture-method-contract.mjs",
  "validate:hardware-hil-raw-evidence-capture": "node scripts/validate-hardware-hil-raw-evidence-capture.mjs",
  "test:hardware-hil-raw-evidence-capture": "node scripts/test-hardware-hil-raw-evidence-capture.mjs",
    "prepare:vendor-contact-receipt": "npm run refresh:vendor-contact-sources && npm run validate:vendor-outbound && node scripts/prepare-vendor-contact-receipt.mjs",
    "check:vendor-contact-send-readiness": "npm run refresh:vendor-contact-sources && npm run validate:vendor-outbound && node scripts/check-vendor-contact-send-readiness.mjs --all",
    "test:vendor-contact-send-readiness": "npm run validate:vendor-outbound && node scripts/test-vendor-contact-send-readiness.mjs",
    "validate:vendor-contact-receipts": "npm run validate:vendor-outbound && node scripts/validate-vendor-contact-receipts.mjs && node scripts/test-vendor-contact-receipts.mjs && node scripts/test-vendor-contact-send-readiness.mjs",
    "validate:bom-revision": "node scripts/validate-bom-revision.mjs",
  "validate:hardware-rd": "npm run validate:hardware-system && npm run validate:eda-system-skeleton && npm run validate:evt0-intake && npm run validate:hardware-evidence-capture && npm run test:hardware-evidence-capture && npm run validate:hardware-test-fixture && npm run test:hardware-test-fixture && npm run validate:hardware-method-gap-evidence && npm run test:hardware-method-gap-evidence && npm run validate:hardware-fixture-method-contract && npm run test:hardware-fixture-method-contract && npm run validate:hardware-hil-raw-evidence-capture && npm run test:hardware-hil-raw-evidence-capture && npm run validate:benchmark-seller-evidence && npm run validate:hardware-lab && npm run validate:vendor-contact-receipts && npm run validate:vendor-evidence && npm run validate:bom-revision && npm run test:hardware",
    "refresh:hardware-evidence": "node scripts/refresh-hardware-evidence.mjs",
    "refresh:vendor-contact-sources": "node scripts/refresh-vendor-contact-sources.mjs",
    "validate:firmware-contracts": "node scripts/validate-firmware-contracts.mjs",
    "validate:rust-firmware": "pwsh -NoProfile -File scripts/validate-rust-firmware.ps1",
    "validate:fast": "npm run validate:architecture && npm run validate:hardware-system && npm run validate:golden-24-projection && npm run typecheck && npm run validate:books",
    "validate:contracts": "npm run validate:architecture && npm run validate:hardware-system && npm run validate:release-gates && npm run validate:golden-24-projection && npm run validate:product-baseline && npm run test:snapshot-sim && npm run test:device-link-sim && npm run validate:family-repository-contracts && npm run test:confirmation-trust && npm run test:confirmation-provider-qualification && npm run test:companion-host && npm run test:family-alpha-compiler && npm run test:execution-model-core && npm run test:weighted-random-v2 && npm run validate:firmware-contracts",
    "validate:full": "npm run validate:product-rd",
    "validate:product-rd": "node tools/release-gates/run-product-rd.mjs",
    "tts": "node scripts/tts-l0.mjs",
    "diy:speak": "node scripts/diy-speak.mjs",
    "tts:l1": "node scripts/tts-l1.mjs",
    "voice:enroll": "node scripts/enroll-voice-sample.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:hardware": "pwsh -NoProfile -File scripts/test-hardware.ps1",
    "tools:doctor": "pwsh -NoProfile -File scripts/check-embedded-tools.ps1 -Route integrated",
    "eda:doctor": "pwsh -NoProfile -File scripts/check-jlceda-codex.ps1 -StartJLCEDA -OutputPath build/jlceda-bridge-status.json",
    "eda:singleton": "pwsh -NoProfile -File scripts/inspect-jlceda-mcp-singleton.ps1 -OutputPath build/jlceda-mcp-singleton.json",
    "eda:shared-http-probe": "node scripts/probe-jlceda-shared-http.mjs",
    "eda:shared-http-poc": "npm run validate:eda-shared-http-poc",
    "validate:eda-shared-http-poc": "node scripts/run-jlceda-shared-http-poc.mjs && node scripts/validate-jlceda-shared-http-poc.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "tsc -b"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/2eho/yimi-pen"
  },
  "bugs": {
    "url": "https://github.com/2eho/yimi-pen/issues"
  },
  "homepage": "https://github.com/2eho/yimi-pen#readme",
  "keywords": [
    "yimi",
    "益米",
    "talking-pen",
    "point-read",
    "kids",
    "open-source",
    "oid",
    "mi-home-friendly"
  ],
  "devDependencies": {
    "@playwright/cli": "0.1.17",
    "@types/node": "^20.19.43",
    "ajv": "8.20.0",
    "typescript": "^5.9.3"
  }
}
