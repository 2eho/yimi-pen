  "evolutionRules": [
    {
      "change": "new-random-provider",
      "reuse": "WeightedRandom v2 raw-u64 contract and no_std selector",
      "acceptance": "add one board RNG adapter and raw-word evidence; integer mapping and product weights stay unchanged"
    },
    {
      "change": "new-board-target",
      "reuse": "yimi no_std cores plus yimi-platform-ffi-v1",
      "acceptance": "add one board adapter and evidence pack; pure cores stay unchanged"
    },
    {
      "change": "new-device-transport",
      "reuse": "DeviceLink v1 transaction core and transcript",
      "acceptance": "add framing adapter; transaction semantics and error codes stay unchanged"
    },
    {
      "change": "new-family-storage",
      "reuse": "FamilyRepository v1 port and repository conformance suite",
      "acceptance": "replace the adapter only; revision, CAS and recovery use cases stay unchanged"
    },
    {
      "change": "new-content-source",
      "reuse": "AuthoringProductSession v1 source port, FamilyWorkspace authoring capability, and existing review/compiler pipeline",
      "acceptance": "add one source adapter plus product-shell fixtures; session core, FamilyRevision, device projection, and installer stay unchanged"
    },
    {
      "change": "new-release-evidence-producer",
      "reuse": "ReleaseGateCatalog v1, EvidenceReceipt v1 and deterministic ReleaseDecision evaluator",
      "acceptance": "add one producer/adapter and artifact-role conformance; validators do not add private blocker arrays"
    },
    {
      "change": "contract-revision",
      "reuse": "one canonical schema owner plus language-independent vectors",
      "acceptance": "add compatibility decision, migration and cross-consumer conformance before adoption"
    }
  ],
  "integrationGates": [
    {
      "id": "AUTHORING_PRODUCT_SESSION_V1",
      "status": "CLOSED",
      "blocks": "shipping a family authoring UI that bypasses capability, immutable revision, or verified-review ordering",
      "ownerDocs": [
        "docs/authoring-product-shell-v1.md",
        "docs/family-authoring-v1.md",
        "docs/family-workspace-v1.md"
      ],
      "closureEvidence": [
        "framework-neutral state transition core with monotonic revision and exact duplicate handling",
        "FILE and CAPTURE converge through one sanitized source receipt and FamilyWorkspace public capabilities; permission identity is locally content-addressed",
        "exact frozen commit replay, stale-head conflict, cancellation barrier, and late callback isolation",
        "review receipt binds session, revision, binding, clip, and asset while direct confirmation stays absent",
        "adapter permission IDs and producer fields stay private; the controller emits fixed non-sensitive durable identities",
        "fixture-only review receipt never elevates buildAuthorized; production authority remains under PRODUCTION_CONFIRMATION_TRUST",
        "device delivery and offline-ready remain separate target evidence gates"
      ]
    },
    {
      "id": "FAMILY_REVISION_BUILD_REQUEST_SPLIT",
      "status": "CLOSED",
      "blocks": "FamilyRepository v1 promotion and production compilation",
      "ownerDocs": [
        "docs/reuse-maintainability.md",
        "docs/family-alpha-v1.md"
      ],
      "closureEvidence": [
        "target-neutral FamilyRevision v1 machine schema",
        "confirmation-free BuildPlan and per-build BuildAuthorization machine schemas",
        "FamilyRevision plus BuildPlan to CompileDraftProjection byte-exact adapter with legacy BuildRequest compatibility",
        "repository, build adapter, confirmation trust and compiler conformance in the aggregate gate"
      ]
    },
    {
      "id": "TARGET_SNAPSHOT_EXECUTION_MODEL_EVIDENCE",
      "status": "EVIDENCE_PENDING",
      "blocks": "claiming Family Snapshot tap-to-clip execution on target firmware",
      "ownerDocs": [
        "docs/reuse-maintainability.md",
        "docs/snapshot-v1.md"
      ],
      "closureEvidence": [
        "ActionKey to zero-based ActionSlot parser contract",
        "per-action cooldown and play-policy planner with injected random source",
        "Family Snapshot to Rust parser/runtime/playback golden vector",
        "two-board same-revision C and Rust differential result"
      ]
    },
    {
      "id": "WEIGHTED_RANDOM_V2_CONTRACT",
      "status": "CLOSED",
      "blocks": "sharing one unbiased integer-weight mapping across Family compiler, host tools and Rust firmware",
      "ownerDocs": [
        "docs/reuse-maintainability.md",
        "docs/snapshot-v1.md"
      ],
      "closureEvidence": [
        "versioned positive-u32 weight and raw-u64 transcript contract",
        "low-prefix rejection mapping with exact per-ticket preimage proof",
        "independent Node and no_std Rust results are byte exact",
        "legacy Pack weight default is isolated in one adapter and existing 2:1 product content is evidence-locked",
        "production Snapshot and target RNG evidence remain in RG-SNAPSHOT-WEIGHTED-RANDOM-VERIFIED"
      ]
    },
    {
      "id": "RELEASE_GATE_CATALOG",
      "status": "CLOSED",
      "blocks": "deriving one product release decision from host, firmware and physical evidence",
      "ownerDocs": [
        "docs/reuse-maintainability.md",
        "docs/product-slice-evt0.md"
      ],
      "closureEvidence": [
        "versioned ReleaseGateCatalog with affirmative stable RG IDs and legacy aliases",
        "EvidenceReceipt schema binds release/evidence subjects, producer, catalog and artifact hashes",
        "ReleaseDecision is deterministic over one catalog and receipt set",
        "host report adapters emit fifteen receipts and current decision retains nineteen physical/production gates",
        "catalog conformance covers identity, order independence, stale subjects, conflicts, synthetic physical rejection and production confirmation self-report rejection"
      ]
    },
    {
      "id": "PRODUCTION_CONFIRMATION_TRUST",
      "status": "EVIDENCE_PENDING",
      "blocks": "claiming production guardian trust or compiling a release-candidate Family Snapshot",
      "ownerDocs": [
        "docs/confirmation-trust-v1.md",
        "docs/family-alpha-v1.md"
      ],
      "closureEvidence": [
        "production authority resolver bound to immutable guardian authority revisions",
        "production signing-key storage, rotation, retirement, revocation and audit evidence",
        "atomic product database replay adapter with multiprocess and crash recovery evidence",
        "provider qualification receipt for the current product release",
        "real BuildAuthorization, ReleaseDecision and release-candidate compilation transcript"
      ]
    }
  ],
