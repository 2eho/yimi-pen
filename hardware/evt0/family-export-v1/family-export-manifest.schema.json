{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.local/schemas/family-export-manifest-v1.json",
  "title": "Yimi complete family export manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "exportId",
    "createdAt",
    "repositoryId",
    "familyLibraryId",
    "headRevisionId",
    "repositoryBackup",
    "assets"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "const": "family-export-v1" },
    "exportId": {
      "type": "string",
      "pattern": "^family-export:sha256:[a-f0-9]{64}$"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "repositoryId": {
      "type": "string",
      "pattern": "^FAMILY-REPO-[A-Z0-9][A-Z0-9._-]{2,127}$"
    },
    "familyLibraryId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "headRevisionId": { "$ref": "#/$defs/sha256Id" },
    "repositoryBackup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "backupId", "sourceStateSha256", "bytes", "sha256"],
      "properties": {
        "path": { "const": "repository-backup.json" },
        "backupId": {
          "type": "string",
          "pattern": "^backup:sha256:[a-f0-9]{64}$"
        },
        "sourceStateSha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "$ref": "#/$defs/bytes" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "path", "bytes", "sha256"],
        "properties": {
          "assetId": {
            "type": "string",
            "pattern": "^asset-[a-z0-9][a-z0-9._-]{2,95}$"
          },
          "path": {
            "type": "string",
            "pattern": "^assets/[a-f0-9]{64}\\.bin$"
          },
          "bytes": { "$ref": "#/$defs/bytes" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sha256Id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
