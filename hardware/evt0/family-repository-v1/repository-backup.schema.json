{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.local/schemas/family-repository-backup-v1.json",
  "title": "Yimi FamilyRepository backup v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "backupId",
    "createdAt",
    "sourceStateSha256",
    "state"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "const": "family-repository-backup-v1" },
    "backupId": {
      "type": "string",
      "pattern": "^backup:sha256:[a-f0-9]{64}$"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "sourceStateSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": { "$ref": "https://yimi.local/schemas/family-repository-state-v1.json" }
  }
}
