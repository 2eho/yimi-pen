{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.local/schemas/family-revision-v1.json",
  "title": "Yimi target-neutral FamilyRevision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "revisionId",
    "familyLibraryId",
    "contentRevision",
    "revisionNumber",
    "parentRevisionId",
    "createdAt",
    "authoringPolicyVersion",
    "sourceProducer",
    "bindings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "const": "family-revision-v1" },
    "revisionId": { "$ref": "#/$defs/sha256Id" },
    "familyLibraryId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "contentRevision": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._@-]{2,95}$"
    },
    "revisionNumber": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "parentRevisionId": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256Id" }
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "authoringPolicyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sourceProducer": { "$ref": "#/$defs/producer" },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/binding" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256Id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 96 },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "logicalOid",
        "label",
        "kind",
        "playPolicy",
        "cooldownMs",
        "bindingRevision",
        "clips"
      ],
      "properties": {
        "bindingId": {
          "type": "string",
          "pattern": "^binding-[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "logicalOid": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": {
          "enum": ["character", "object", "word", "song", "story", "egg", "ui"]
        },
        "playPolicy": { "enum": ["replace", "queue", "random_one"] },
        "cooldownMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "bindingRevision": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "clips": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/clip" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "playPolicy": { "const": "replace" } },
            "required": ["playPolicy"]
          },
          "then": { "properties": { "clips": { "type": "array", "maxItems": 1 } } }
        },
        {
          "if": {
            "properties": { "playPolicy": { "const": "random_one" } },
            "required": ["playPolicy"]
          },
          "then": { "properties": { "clips": { "type": "array", "minItems": 2 } } }
        }
      ]
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clipId",
        "assetId",
        "assetSha256",
        "assetBytes",
        "sourceKind",
        "transcript",
        "mediaType",
        "language"
      ],
      "properties": {
        "clipId": {
          "type": "string",
          "pattern": "^clip-[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "assetId": {
          "type": "string",
          "pattern": "^asset-[a-z0-9][a-z0-9._-]{2,95}$"
        },
        "assetSha256": { "$ref": "#/$defs/sha256" },
        "assetBytes": { "type": "integer", "minimum": 1 },
        "sourceKind": { "enum": ["family-recording", "system-tts"] },
        "transcript": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "mediaType": { "enum": ["voice", "narration", "sfx", "song"] },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
        }
      }
    }
  }
}
