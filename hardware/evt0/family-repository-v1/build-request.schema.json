{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.local/schemas/family-build-request-v1.json",
  "title": "Yimi resolved Family BuildRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "buildRequestId",
    "requestedAt",
    "familyRevisionId",
    "fixtureOnly",
    "outputMode",
    "expectedCompilerProfile",
    "confirmation",
    "targetProfile",
    "physicalMap",
    "codecProfile",
    "assetCatalog",
    "releaseGateReceiptRef",
    "expectedProjection"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "const": "family-build-request-v1" },
    "buildRequestId": {
      "type": "string",
      "pattern": "^BUILD-[A-Z0-9][A-Z0-9._-]{2,127}$"
    },
    "requestedAt": { "type": "string", "format": "date-time" },
    "familyRevisionId": { "$ref": "#/$defs/sha256Id" },
    "fixtureOnly": { "type": "boolean" },
    "outputMode": { "enum": ["design-fixture", "release-candidate"] },
    "expectedCompilerProfile": { "const": "family-alpha-draft-v1" },
    "confirmation": { "$ref": "#/$defs/confirmation" },
    "targetProfile": { "$ref": "#/$defs/targetProfile" },
    "physicalMap": { "$ref": "#/$defs/physicalMap" },
    "codecProfile": { "$ref": "#/$defs/codecProfile" },
    "assetCatalog": { "$ref": "#/$defs/assetCatalog" },
    "releaseGateReceiptRef": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^receipt:[a-z0-9][a-z0-9._:-]{2,159}$"
        }
      ]
    },
    "expectedProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSha256"],
      "properties": {
        "sourceSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outputMode": { "const": "design-fixture" } },
        "required": ["outputMode"]
      },
      "then": {
        "properties": {
          "fixtureOnly": { "const": true },
          "releaseGateReceiptRef": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "outputMode": { "const": "release-candidate" } },
        "required": ["outputMode"]
      },
      "then": {
        "properties": {
          "fixtureOnly": { "const": false },
          "releaseGateReceiptRef": { "type": "string" },
          "physicalMap": {
            "type": "object",
            "properties": { "status": { "const": "assigned" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sha256Id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._:-]{2,159}$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\/$)[A-Za-z0-9._/-]+$"
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmationId", "semanticSha256", "previewId", "projectionSourceSha256"],
      "properties": {
        "confirmationId": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$"
        },
        "semanticSha256": { "$ref": "#/$defs/sha256" },
        "previewId": { "$ref": "#/$defs/sha256Id" },
        "projectionSourceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "targetProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "boardTarget", "firmwareMin", "capabilities"],
      "properties": {
        "ref": { "$ref": "#/$defs/ref" },
        "boardTarget": { "type": "string", "minLength": 1, "maxLength": 96 },
        "firmwareMin": { "type": "string", "minLength": 1, "maxLength": 64 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 96 }
        }
      }
    },
    "physicalMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revisionRef", "status", "entries"],
      "properties": {
        "revisionRef": { "$ref": "#/$defs/ref" },
        "status": { "enum": ["unassigned", "assigned"] },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["logicalOid", "physicalCode"],
            "properties": {
              "logicalOid": {
                "type": "string",
                "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
              },
              "physicalCode": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "string",
                    "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                  }
                ]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "assigned" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "physicalCode": {
                      "type": "string",
                      "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "physicalCode": { "type": "null" } }
                }
              }
            }
          }
        }
      ]
    },
    "codecProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "acceptedSourceCodecs", "snapshotCodec"],
      "properties": {
        "ref": { "$ref": "#/$defs/ref" },
        "acceptedSourceCodecs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "snapshotCodec": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "assetCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revisionRef", "assets"],
      "properties": {
        "revisionRef": { "$ref": "#/$defs/ref" },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assetId", "path", "bytes", "sha256", "codec"],
            "properties": {
              "assetId": {
                "type": "string",
                "pattern": "^asset-[a-z0-9][a-z0-9._-]{2,95}$"
              },
              "path": { "$ref": "#/$defs/safePath" },
              "bytes": { "type": "integer", "minimum": 1 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "codec": { "type": "string", "minLength": 1, "maxLength": 64 }
            }
          }
        }
      }
    }
  }
}
