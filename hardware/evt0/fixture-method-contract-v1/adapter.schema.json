{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi-pen.local/schemas/fixture-method-contract-adapter-v1.json",
  "title": "USB and control/status HIL method-specific adapter template v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordKind",
    "adapterTemplateId",
    "contractPackageId",
    "contractRevision",
    "status",
    "boardTargetState",
    "contractMethodIds",
    "methods",
    "effects"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordKind": {
      "const": "hardware-fixture-method-contract-method-adapter-v1"
    },
    "adapterTemplateId": {
      "const": "METHOD-ADAPTER-TEMPLATE-USB-CONTROL-HIL-V1"
    },
    "contractPackageId": {
      "const": "HW-FIXTURE-METHOD-CONTRACT-USB-CONTROL-HIL-V1"
    },
    "contractRevision": {
      "const": "1.0.0"
    },
    "status": {
      "const": "TEMPLATE_ONLY"
    },
    "boardTargetState": {
      "const": "UNRESOLVED"
    },
    "contractMethodIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PROPOSED-USB-DATA-OBSERVATION-001",
          "PROPOSED-CONTROL-STATUS-HIL-001"
        ]
      }
    },
    "methods": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/method"
      }
    },
    "effects": {
      "$ref": "#/$defs/effects"
    }
  },
  "$defs": {
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodId",
        "fields"
      ],
      "properties": {
        "methodId": {
          "enum": [
            "PROPOSED-USB-DATA-OBSERVATION-001",
            "PROPOSED-CONTROL-STATUS-HIL-001"
          ]
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "value",
        "evidenceRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "state": {
          "const": "PENDING_EVIDENCE"
        },
        "value": {
          "type": "null"
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetBinding",
        "physicalEvidence",
        "qualification",
        "releaseGate",
        "promotion",
        "software"
      ],
      "properties": {
        "targetBinding": {
          "const": "NONE"
        },
        "physicalEvidence": {
          "const": "NONE"
        },
        "qualification": {
          "const": "NONE"
        },
        "releaseGate": {
          "const": "NONE"
        },
        "promotion": {
          "const": "NONE"
        },
        "software": {
          "const": "NONE"
        }
      }
    }
  }
}
