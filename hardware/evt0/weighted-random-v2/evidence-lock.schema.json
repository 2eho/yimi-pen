{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.local/schemas/weighted-random-evidence-lock-v2.json",
  "title": "Yimi weighted random v2 evidence lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "reviewedAt",
    "localTruth",
    "primarySources",
    "decisions"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "profile": { "const": "weighted-random-evidence-lock-v2" },
    "reviewedAt": { "const": "2026-08-03" },
    "localTruth": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "claim"],
        "properties": {
          "path": { "type": "string", "pattern": "^[a-zA-Z0-9._/-]+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "claim": { "type": "string", "minLength": 8, "maxLength": 240 }
        }
      }
    },
    "primarySources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "url", "lockedRevision", "claim", "useBoundary"],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
          "url": { "type": "string", "pattern": "^https://" },
          "lockedRevision": { "type": "string", "minLength": 2, "maxLength": 128 },
          "contentSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "claim": { "type": "string", "minLength": 8, "maxLength": 320 },
          "useBoundary": { "type": "string", "minLength": 8, "maxLength": 320 }
        }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weightDefault", "weightRange", "sampleSpace", "mapping", "productionBoundary"],
      "properties": {
        "weightDefault": { "const": 1 },
        "weightRange": { "const": "1..4294967295 per clip; 2..32 clips" },
        "sampleSpace": { "const": "uniform raw u64 words; low-prefix rejection" },
        "mapping": { "const": "array-order half-open cumulative integer ranges" },
        "productionBoundary": { "const": "host contract evidence does not close RG-SNAPSHOT-WEIGHTED-RANDOM-VERIFIED" }
      }
    }
  }
}
