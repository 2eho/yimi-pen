{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.local/schemas/snapshot-execution-result-v1.json",
  "title": "Yimi Snapshot execution result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "sourceProfile", "executionModel", "trace", "allPassed"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "const": "snapshot-execution-result-v1" },
    "sourceProfile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "executionModel": { "$ref": "https://yimi.local/schemas/snapshot-execution-model-v1.json" },
    "trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decision",
          "actionKey",
          "actionSlot",
          "playPolicy",
          "clipKeys",
          "clipSlots",
          "randomIndexConsumed",
          "expectedMatched"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^TAP-[A-Z0-9-]{2,31}$" },
          "decision": { "enum": ["ignore-invalid", "suppress-cooldown", "unbound", "play"] },
          "actionKey": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^action-[a-z0-9][a-z0-9._-]{2,63}$" }
            ]
          },
          "actionSlot": {
            "oneOf": [
              { "type": "null" },
              { "type": "integer", "minimum": 0, "maximum": 4294967295 }
            ]
          },
          "playPolicy": {
            "oneOf": [
              { "type": "null" },
              { "enum": ["replace", "queue", "random_one"] }
            ]
          },
          "clipKeys": {
            "type": "array",
            "items": { "type": "string", "pattern": "^clip-[a-z0-9][a-z0-9._-]{2,63}$" }
          },
          "clipSlots": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
          },
          "randomIndexConsumed": { "type": "boolean" },
          "expectedMatched": { "type": "boolean" }
        }
      }
    },
    "allPassed": { "type": "boolean" }
  }
}
