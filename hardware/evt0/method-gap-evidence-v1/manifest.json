          },
          {
            "id": "STEP-02",
            "action": "Create known content and metadata states with a content-addressed pre-interruption manifest and a reproducible checkpoint sequence.",
            "targetDependentFields": [
              "CONTENT_SET",
              "METADATA_SET",
              "CHECKPOINT_RULE",
              "SYNC_BOUNDARY"
            ],
            "physicalThresholdState": "PENDING"
          },
          {
            "id": "STEP-03",
            "action": "Interrupt power at target-defined write and idle phases, restart through the target recovery path, and retain every power, log, and filesystem observation.",
