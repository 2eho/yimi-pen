      },
      "targetNeutralSkeleton": {
        "state": "PENDING_DRAFT_NOT_FREEZABLE",
        "steps": [
          {
            "id": "STEP-01",
            "action": "Record the target storage technology, filesystem, commit model, capacity, and recovery contract from primary target evidence before selecting an interruption procedure.",
            "targetDependentFields": [
              "STORAGE_TECHNOLOGY",
              "FILESYSTEM",
              "CAPACITY",
              "COMMIT_MODEL",
              "RECOVERY_CONTRACT"
            ],
