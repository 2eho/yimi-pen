{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.local/schemas/release-host-validation-run-v1.json",
  "title": "Yimi sealed host validation run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "hostRunId",
    "catalogId",
    "hostAdapterRegistrySha256",
    "startedAt",
    "completedAt",
    "sourceSet",
    "reports"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "const": "release-host-validation-run-v1" },
    "hostRunId": { "type": "string", "pattern": "^host-run:sha256:[a-f0-9]{64}$" },
    "catalogId": { "type": "string", "pattern": "^rgc:sha256:[a-f0-9]{64}$" },
    "hostAdapterRegistrySha256": { "$ref": "#/$defs/sha256" },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "completedAt": { "$ref": "#/$defs/timestamp" },
    "sourceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "fileCount", "totalBytes", "sourceSetSha256"],
      "properties": {
        "profile": { "const": "release-source-set-v1" },
        "fileCount": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "totalBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "sourceSetSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/report" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "safePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\/$)[A-Za-z0-9._/-]+$"
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "sha256", "mtimeNs", "ctimeNs"],
      "properties": {
        "size": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mtimeNs": { "type": "string", "pattern": "^[0-9]+$" },
        "ctimeNs": { "type": "string", "pattern": "^[0-9]+$" }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "reportPath", "refreshedDuringRun", "prior", "current"],
      "properties": {
        "gateId": { "type": "string", "pattern": "^RG-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
        "reportPath": { "$ref": "#/$defs/safePath" },
        "refreshedDuringRun": { "const": true },
        "prior": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/fingerprint" }
          ]
        },
        "current": { "$ref": "#/$defs/fingerprint" }
      }
    }
  }
}
