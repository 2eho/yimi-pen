{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.local/schemas/release-host-report-adapters-v1.json",
  "title": "Yimi host report to EvidenceReceipt adapters v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "adapters"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "const": "release-host-report-adapters-v1" },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gateId",
          "producerId",
          "producerVersion",
          "reportPath",
          "expectedProfile",
          "syntheticEvidence",
          "passConditions",
          "claimRefs"
        ],
        "properties": {
          "gateId": { "type": "string", "pattern": "^RG-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
          "producerId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
          "producerVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
          "reportPath": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\/$)[A-Za-z0-9._/-]+$"
          },
          "expectedProfile": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "minLength": 3, "maxLength": 100 }
            ]
          },
          "syntheticEvidence": { "type": "boolean" },
          "passConditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pointer", "operator", "expected"],
              "properties": {
                "pointer": { "type": "string", "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$" },
                "operator": { "enum": ["equals", "equalsPointer", "allTrue"] },
                "expected": {}
              },
              "allOf": [
                {
                  "if": { "properties": { "operator": { "const": "equalsPointer" } }, "required": ["operator"] },
                  "then": { "properties": { "expected": { "type": "string", "pattern": "^/" } } }
                },
                {
                  "if": { "properties": { "operator": { "const": "allTrue" } }, "required": ["operator"] },
                  "then": { "properties": { "expected": { "type": "null" } } }
                }
              ]
            }
          },
          "claimRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 3, "maxLength": 200 }
          }
        }
      }
    }
  }
}
