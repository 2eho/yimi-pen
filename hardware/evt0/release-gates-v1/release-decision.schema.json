{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.local/schemas/release-decision-v1.json",
  "title": "Yimi ReleaseDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "decisionId",
    "catalogId",
    "catalogVersion",
    "evaluatedAt",
    "releaseSubject",
    "receiptIds",
    "receiptSetSha256",
    "passedGateIds",
    "failedGateIds",
    "missingGateIds",
    "blockingGateIds",
    "releaseReady"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "const": "release-decision-v1" },
    "decisionId": { "type": "string", "pattern": "^decision:sha256:[a-f0-9]{64}$" },
    "catalogId": { "type": "string", "pattern": "^rgc:sha256:[a-f0-9]{64}$" },
    "catalogVersion": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
    "evaluatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "releaseSubject": { "$ref": "https://yimi.local/schemas/evidence-receipt-v1.json#/$defs/releaseSubject" },
    "receiptIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^receipt:sha256:[a-f0-9]{64}$" }
    },
    "receiptSetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "passedGateIds": { "$ref": "#/$defs/gateIds" },
    "failedGateIds": { "$ref": "#/$defs/gateIds" },
    "missingGateIds": { "$ref": "#/$defs/gateIds" },
    "blockingGateIds": { "$ref": "#/$defs/gateIds" },
    "releaseReady": { "type": "boolean" }
  },
  "$defs": {
    "gateIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^RG-[A-Z0-9]+(?:-[A-Z0-9]+)*$" }
    }
  }
}
