{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.local/schemas/evt0-test-fixture-instance-v1.json",
  "title": "Yimi Pen EVT-0 physical fixture instance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordKind",
    "instanceId",
    "revision",
    "status",
    "profileRef",
    "adapterRef",
    "labRegistryRef",
    "physicalIdentity",
    "calibration",
    "qualification",
    "claims",
    "effects",
    "blockers"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordKind": {
      "const": "evt0-test-fixture-instance"
    },
    "instanceId": {
      "type": "string",
      "pattern": "^EVT0-FIXTURE-INSTANCE-[A-Z0-9-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "TEMPLATE",
        "PENDING",
        "QUALIFIED"
      ]
    },
    "profileRef": {
      "$ref": "#/$defs/profileRef"
    },
    "adapterRef": {
      "$ref": "#/$defs/adapterRef"
    },
    "labRegistryRef": {
      "$ref": "#/$defs/labRegistryRef"
    },
    "physicalIdentity": {
      "$ref": "#/$defs/physicalIdentity"
    },
    "calibration": {
      "$ref": "#/$defs/calibration"
    },
    "qualification": {
      "$ref": "#/$defs/qualification"
    },
    "claims": {
      "$ref": "#/$defs/claims"
    },
    "effects": {
      "$ref": "#/$defs/effects"
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "profileId",
        "revision"
      ],
      "properties": {
        "path": {
          "const": "hardware/evt0/test-fixture-v1/profile.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profileId": {
          "const": "HW-REUSABLE-TEST-FIXTURE-ARCHITECTURE-V1"
        },
        "revision": {
          "const": "1.0.0"
        }
      }
    },
    "adapterRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "adapterId",
        "revision"
      ],
      "properties": {
        "path": {
          "const": "hardware/evt0/test-fixture-v1/adapter.template.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "adapterId": {
          "type": "string",
          "pattern": "^EVT0-TARGET-ADAPTER-[A-Z0-9-]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "labRegistryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "registryId",
        "status"
      ],
      "properties": {
        "path": {
          "const": "hardware/evt0/lab-v1/instrument-registry.template.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "registryId": {
          "const": "EVT0-LAB-REGISTRY-TEMPLATE"
        },
        "status": {
          "const": "TEMPLATE"
        }
      }
    },
    "nullableString": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "physicalIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registrationState",
        "serial",
        "localAssetTag",
        "identityArtifactRefs",
        "physicalEvidenceState"
      ],
      "properties": {
        "registrationState": {
          "enum": [
            "NOT_REGISTERED",
            "REGISTERED"
          ]
        },
        "serial": {
          "$ref": "#/$defs/nullableString"
        },
        "localAssetTag": {
          "$ref": "#/$defs/nullableString"
        },
        "identityArtifactRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "physicalEvidenceState": {
          "enum": [
            "PENDING",
            "MEASURED"
          ]
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "certificateArtifactRefs",
        "referenceArtifactRefs",
        "result"
      ],
      "properties": {
        "state": {
          "enum": [
            "PENDING",
            "TRACEABLE",
            "CALIBRATION_CERTIFICATE"
          ]
        },
        "certificateArtifactRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "referenceArtifactRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "result": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "physicalReady",
        "effect"
      ],
      "properties": {
        "state": {
          "enum": [
            "NOT_CLAIMED",
            "PENDING",
            "QUALIFIED"
          ]
        },
        "physicalReady": {
          "type": "boolean"
        },
        "effect": {
          "const": "NONE"
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physicalFixture",
        "serialKnown",
        "calibrationKnown",
        "qualified",
        "releaseGateClosed",
        "boardStatePromoted"
      ],
      "properties": {
        "physicalFixture": {
          "type": "boolean"
        },
        "serialKnown": {
          "type": "boolean"
        },
        "calibrationKnown": {
          "type": "boolean"
        },
        "qualified": {
          "type": "boolean"
        },
        "releaseGateClosed": {
          "type": "boolean"
        },
        "boardStatePromoted": {
          "type": "boolean"
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetBinding",
        "adapter",
        "physicalEvidence",
        "releaseGate",
        "promotion"
      ],
      "properties": {
        "targetBinding": {
          "const": "NONE"
        },
        "adapter": {
          "const": "NONE"
        },
        "physicalEvidence": {
          "const": "NONE"
        },
        "releaseGate": {
          "const": "NONE"
        },
        "promotion": {
          "const": "NONE"
        }
      }
    }
  }
}
