    "diagnosticContext": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "boolean",
          "null"
        ]
      },
      "maxProperties": 16
    },
    "diagnosticEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "code",
        "severity",
        "context"
      ],
      "properties": {
        "sequence": {
          "$ref": "#/$defs/u64Decimal"
        },
        "code": {
