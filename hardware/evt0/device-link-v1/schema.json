            "info",
            "warning",
            "error"
          ]
        },
        "context": {
          "$ref": "#/$defs/diagnosticContext"
        }
      }
    },
    "diagnosticsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "nextAfterSequence",
        "hasMore"
      ],
      "properties": {
        "events": {
          "type": "array",
          "maxItems": 1024,
          "items": {
