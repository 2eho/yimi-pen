        "installPhase",
        "bootSelection"
      ],
      "properties": {
        "activeSnapshotId": {
          "$ref": "#/$defs/snapshotId"
        },
        "lastGoodSnapshotId": {
          "$ref": "#/$defs/snapshotId"
        },
        "generation": {
          "$ref": "#/$defs/u64Decimal"
        },
