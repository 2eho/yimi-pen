              "$ref": "#/$defs/safePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "nextDurableOffset": {
          "$ref": "#/$defs/u64Decimal"
        }
      }
    },
    "statusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootSessionId",
        "deviceState",
        "installPhase",
        "bootSelection",
        "activeSnapshotId",
        "lastGoodSnapshotId",
        "generation",
        "lastInstallOutcome",
        "staging"
      ],
      "properties": {
        "bootSessionId": {
          "$ref": "#/$defs/bootSessionId"
        },
        "deviceState": {
          "$ref": "#/$defs/deviceState"
        },
        "installPhase": {
          "$ref": "#/$defs/installPhase"
        },
        "bootSelection": {
          "$ref": "#/$defs/bootSelection"
        },
        "activeSnapshotId": {
          "oneOf": [
            {
              "$ref": "#/$defs/snapshotId"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastGoodSnapshotId": {
          "oneOf": [
            {
              "$ref": "#/$defs/snapshotId"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "$ref": "#/$defs/u64Decimal"
        },
        "lastInstallOutcome": {
          "$ref": "#/$defs/lastInstallOutcome"
        },
        "staging": {
          "oneOf": [
            {
              "$ref": "#/$defs/stagingStatus"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "stageBeginResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transactionId",
        "snapshotId",
        "resumed",
        "receivedBytes",
        "installPhase"
      ],
      "properties": {
        "transactionId": {
          "$ref": "#/$defs/transactionId"
        },
        "snapshotId": {
          "$ref": "#/$defs/snapshotId"
        },
        "resumed": {
          "type": "boolean"
        },
        "receivedBytes": {
          "$ref": "#/$defs/u64Decimal"
        },
        "installPhase": {
          "const": "Staging"
        }
      }
    },
    "stageWriteResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transactionId",
        "path",
        "nextDurableOffset",
        "receivedBytes",
