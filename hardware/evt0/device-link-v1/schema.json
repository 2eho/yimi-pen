          "$ref": "#/$defs/transactionId"
        },
        "activeSnapshotId": {
          "$ref": "#/$defs/snapshotId"
        },
        "lastGoodSnapshotId": {
          "oneOf": [
            {
              "$ref": "#/$defs/snapshotId"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "$ref": "#/$defs/u64Decimal"
        },
        "installPhase": {
          "const": "Idle"
        },
        "bootSelection": {
          "const": "Active"
        }
      }
    },
    "abortResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transactionId",
