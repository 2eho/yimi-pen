      "properties": {
        "transactionId": {
          "$ref": "#/$defs/transactionId"
        },
        "path": {
          "$ref": "#/$defs/safePath"
        },
        "nextDurableOffset": {
          "$ref": "#/$defs/u64Decimal"
        },
        "receivedBytes": {
          "$ref": "#/$defs/u64Decimal"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "verifyResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transactionId",
        "snapshotId",
        "installPhase"
      ],
      "properties": {
        "transactionId": {
          "$ref": "#/$defs/transactionId"
        },
        "snapshotId": {
          "$ref": "#/$defs/snapshotId"
        },
        "installPhase": {
          "const": "ReadyToActivate"
        }
