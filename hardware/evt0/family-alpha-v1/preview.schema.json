{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "fixtureOnly",
    "status",
    "presentationPolicyVersion",
    "sourceSha256",
    "previewId",
    "bindings",
    "summary",
    "privacy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profile": {
      "const": "family-alpha-preview-v1"
    },
    "fixtureOnly": {
      "type": "boolean"
    },
    "status": {
      "const": "AWAITING_GUARDIAN_CONFIRMATION"
    },
    "presentationPolicyVersion": {
      "const": "family-alpha-v1"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previewId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bindingId",
          "logicalOid",
          "label",
          "kind",
          "playPolicy",
          "cooldownMs",
          "revision",
          "contentSha256",
          "clips"
        ],
        "properties": {
          "bindingId": {
            "type": "string",
            "pattern": "^binding-[a-z0-9][a-z0-9._-]{2,63}$"
          },
          "logicalOid": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "character",
              "object",
              "word",
              "song",
              "story",
              "egg",
              "ui"
            ]
          },
          "playPolicy": {
            "enum": [
              "replace",
              "queue",
              "random_one"
            ]
          },
          "cooldownMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "contentSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "clips": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "clipId",
                "assetPath",
                "bytes",
                "sha256",
                "durationMs",
                "sourceKind",
                "transcript",
                "mediaType",
                "language",
                "codec"
              ],
              "properties": {
                "clipId": {
                  "type": "string"
                },
                "assetPath": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240,
                  "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\/$)[A-Za-z0-9._/-]+$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 45
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "durationMs": {
                  "type": "integer",
                  "minimum": 1
                },
                "sourceKind": {
                  "enum": [
                    "family-recording",
                    "system-tts"
                  ]
                },
                "transcript": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "mediaType": {
                  "enum": [
                    "voice",
                    "narration",
                    "sfx",
                    "song"
                  ]
                },
                "language": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
                },
                "codec": {
                  "const": "WAV_PCM16_16K_MONO"
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingCount",
        "clipCount",
        "audioBytes"
      ],
      "properties": {
        "bindingCount": {
          "type": "integer",
          "minimum": 1
        },
        "clipCount": {
          "type": "integer",
          "minimum": 1
        },
        "audioBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voiceProfileSamplesIncluded",
        "voiceModelIncluded",
        "familyPhotosIncluded",
        "cloudCredentialsIncluded"
      ],
      "properties": {
        "voiceProfileSamplesIncluded": {
          "const": false
        },
        "voiceModelIncluded": {
          "const": false
        },
        "familyPhotosIncluded": {
          "const": false
        },
        "cloudCredentialsIncluded": {
          "const": false
        }
      }
    }
  }
}
