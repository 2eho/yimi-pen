{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.local/schemas/family-alpha-draft-v1.json",
  "title": "Yimi Family Alpha v1 compiler draft projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "fixtureOnly",
    "familyLibraryId",
    "contentRevision",
    "createdAt",
    "releaseState",
    "sourceProducer",
    "target",
    "bindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profile": {
      "const": "family-alpha-draft-v1"
    },
    "fixtureOnly": {
      "type": "boolean"
    },
    "familyLibraryId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "contentRevision": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._@-]{2,95}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "releaseState": {
      "enum": [
        "design-fixture",
        "release-candidate"
      ]
    },
    "sourceProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boardTarget",
        "firmwareMin",
        "physicalMapStatus",
        "capabilities"
      ],
      "properties": {
        "boardTarget": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "firmwareMin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "physicalMapStatus": {
          "enum": [
            "unassigned",
            "assigned"
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bindingId",
          "logicalOid",
          "physicalCode",
          "actionId",
          "label",
          "kind",
          "playPolicy",
          "cooldownMs",
          "revision",
          "clips"
        ],
        "properties": {
          "bindingId": {
            "type": "string",
            "pattern": "^binding-[a-z0-9][a-z0-9._-]{2,63}$"
          },
          "logicalOid": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
          },
          "physicalCode": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]{0,19})$"
              }
            ]
          },
          "actionId": {
            "type": "string",
            "pattern": "^action-[a-z0-9][a-z0-9._-]{2,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "character",
              "object",
              "word",
              "song",
              "story",
              "egg",
              "ui"
            ]
          },
          "playPolicy": {
            "enum": [
              "replace",
              "queue",
              "random_one"
            ]
          },
          "cooldownMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "clips": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "clipId",
                "assetPath",
                "sourceKind",
                "transcript",
                "mediaType",
                "language",
                "codec"
              ],
              "properties": {
                "clipId": {
                  "type": "string",
                  "pattern": "^clip-[a-z0-9][a-z0-9._-]{2,63}$"
                },
                "assetPath": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240,
                  "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\/$)[A-Za-z0-9._/-]+$"
                },
                "sourceKind": {
                  "enum": [
                    "family-recording",
                    "system-tts"
                  ]
                },
                "transcript": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "mediaType": {
                  "enum": [
                    "voice",
                    "narration",
                    "sfx",
                    "song"
                  ]
                },
                "language": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
                },
                "codec": {
                  "const": "WAV_PCM16_16K_MONO"
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "releaseState": {
            "const": "release-candidate"
          }
        },
        "required": [
          "releaseState"
        ]
      },
      "then": {
        "properties": {
          "fixtureOnly": {
            "const": false
          },
          "target": {
            "properties": {
              "physicalMapStatus": {
                "const": "assigned"
              }
            },
            "type": "object"
          },
          "bindings": {
            "items": {
              "properties": {
                "physicalCode": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fixtureOnly": {
            "const": true
          }
        },
        "required": [
          "fixtureOnly"
        ]
      },
      "then": {
        "properties": {
          "releaseState": {
            "const": "design-fixture"
          }
        }
      }
    }
  ]
}
