{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.local/schemas/confirmation-trust-policy-v1.json",
  "title": "Yimi confirmation trust policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "profile", "policyId", "fixtureOnly", "providerId",
    "signatureProfile", "algorithm", "purpose", "audience",
    "maxChallengeLifetimeSeconds", "maxProofLifetimeSeconds", "clockSkewSeconds",
    "keyring", "authorities"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "const": "confirmation-trust-policy-v1" },
    "policyId": { "$ref": "https://yimi.local/schemas/confirmation-trust-common-v1.json#/$defs/policyId" },
    "fixtureOnly": { "type": "boolean" },
    "providerId": { "const": "confirmation-trust-provider" },
    "signatureProfile": { "const": "Ed25519+JCS-prefix-v1" },
    "algorithm": { "const": "Ed25519" },
    "purpose": { "const": "snapshot-build" },
    "audience": { "const": "yimi-family-alpha-compiler" },
    "maxChallengeLifetimeSeconds": { "type": "integer", "minimum": 1, "maximum": 900 },
    "maxProofLifetimeSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "clockSkewSeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
    "keyring": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kid", "algorithm", "publicJwk", "state", "notBefore", "signUntil", "verifyUntil"],
        "properties": {
          "kid": { "$ref": "https://yimi.local/schemas/confirmation-trust-common-v1.json#/$defs/kid" },
          "algorithm": { "const": "Ed25519" },
          "publicJwk": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kty", "crv", "x"],
            "properties": {
              "kty": { "const": "OKP" },
              "crv": { "const": "Ed25519" },
              "x": { "$ref": "https://yimi.local/schemas/confirmation-trust-common-v1.json#/$defs/base64url256" }
            }
          },
          "state": { "enum": ["active", "retired", "revoked"] },
          "notBefore": { "$ref": "https://yimi.local/schemas/confirmation-trust-common-v1.json#/$defs/rfc3339" },
          "signUntil": { "$ref": "https://yimi.local/schemas/confirmation-trust-common-v1.json#/$defs/rfc3339" },
          "verifyUntil": { "$ref": "https://yimi.local/schemas/confirmation-trust-common-v1.json#/$defs/rfc3339" }
        }
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authorityRevisionId", "guardianSubjectRef", "familyLibraryId", "role",
          "state", "validFrom", "authorizeUntil", "verifyUntil"
        ],
        "properties": {
          "authorityRevisionId": { "$ref": "https://yimi.local/schemas/confirmation-trust-common-v1.json#/$defs/authorityRevisionId" },
          "guardianSubjectRef": { "$ref": "https://yimi.local/schemas/confirmation-trust-common-v1.json#/$defs/guardianSubjectRef" },
          "familyLibraryId": { "$ref": "https://yimi.local/schemas/confirmation-trust-common-v1.json#/$defs/familyLibraryId" },
          "role": { "enum": ["parent", "guardian"] },
          "state": { "enum": ["active", "retired", "revoked"] },
          "validFrom": { "$ref": "https://yimi.local/schemas/confirmation-trust-common-v1.json#/$defs/rfc3339" },
          "authorizeUntil": { "$ref": "https://yimi.local/schemas/confirmation-trust-common-v1.json#/$defs/rfc3339" },
          "verifyUntil": { "$ref": "https://yimi.local/schemas/confirmation-trust-common-v1.json#/$defs/rfc3339" }
        }
      }
    }
  }
}
