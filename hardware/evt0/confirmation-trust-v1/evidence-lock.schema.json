{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.local/schemas/confirmation-trust-evidence-lock-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "retrievedAt", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "const": "confirmation-trust-evidence-lock-v1" },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "url", "bytes", "sha256", "supports"],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
          "url": { "type": "string", "pattern": "^https://" },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "supports": { "type": "string", "minLength": 3, "maxLength": 300 }
        }
      }
    }
  }
}
