{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.local/schemas/confirmation-trust-common-v1.json",
  "title": "Yimi confirmation trust common types v1",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sha256Id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "policyId": { "type": "string", "pattern": "^policy:sha256:[a-f0-9]{64}$" },
    "challengeId": { "type": "string", "pattern": "^challenge:sha256:[a-f0-9]{64}$" },
    "proofId": { "type": "string", "pattern": "^proof:sha256:[a-f0-9]{64}$" },
    "verificationId": { "type": "string", "pattern": "^verification:sha256:[a-f0-9]{64}$" },
    "buildPlanId": { "type": "string", "pattern": "^PLAN-[A-Z0-9][A-Z0-9._-]{2,127}$" },
    "familyLibraryId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$" },
    "confirmationId": { "type": "string", "pattern": "^CONF-[A-Z0-9][A-Z0-9-]{2,63}$" },
    "authorityRevisionId": { "type": "string", "pattern": "^authority-revision:sha256:[a-f0-9]{64}$" },
    "guardianSubjectRef": { "type": "string", "pattern": "^guardian:sha256:[a-f0-9]{64}$" },
    "operationId": { "type": "string", "pattern": "^op:[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "kid": { "type": "string", "pattern": "^urn:ietf:params:oauth:jwk-thumbprint:sha-256:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$" },
    "base64url128": { "type": "string", "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$" },
    "base64url256": { "type": "string", "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$" },
    "ed25519Signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$" },
    "rfc3339": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?(?:Z|[+-](?:0[0-9]|1[0-9]|2[0-3]):[0-5][0-9])$"
    }
  }
}
