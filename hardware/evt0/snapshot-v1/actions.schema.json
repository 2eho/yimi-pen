{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actionId",
          "playPolicy",
          "clipIds",
          "cooldownMs"
        ],
        "properties": {
          "actionId": {
            "type": "string",
            "pattern": "^action-[a-z0-9][a-z0-9._-]{2,63}$"
          },
          "playPolicy": {
            "enum": [
              "replace",
              "queue",
              "random_one"
            ]
          },
          "clipIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^clip-[a-z0-9][a-z0-9._-]{2,63}$"
            }
          },
          "cooldownMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          },
          "designSource": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "codecPlan": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "playPolicy": {
                  "const": "replace"
                }
              },
              "required": [
                "playPolicy"
              ]
            },
            "then": {
              "properties": {
                "clipIds": {
                  "type": "array",
                  "maxItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "playPolicy": {
                  "const": "random_one"
                }
              },
              "required": [
                "playPolicy"
              ]
            },
            "then": {
              "properties": {
                "clipIds": {
                  "type": "array",
                  "minItems": 2
                }
              }
            }
          }
        ]
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clipId",
          "path",
          "size",
          "sha256",
          "codec",
          "mediaType"
        ],
        "properties": {
          "clipId": {
            "type": "string",
            "pattern": "^clip-[a-z0-9][a-z0-9._-]{2,63}$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\\/$)[A-Za-z0-9._/-]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "codec": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "mediaType": {
            "enum": [
              "voice",
              "narration",
              "sfx",
              "song",
              "bgm"
            ]
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yimi.local/schemas/snapshot-actions-v1.json",
  "title": "Yimi Snapshot v1 action and optional clip catalog"
}
